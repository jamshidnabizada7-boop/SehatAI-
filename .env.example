# ============================================================
# SehatAI Environment Variables (EXAMPLE - safe to commit)
# Copy to .env and fill with real values. NEVER commit .env
# ============================================================

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Tier 1: Google Gemini (primary LLM)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Tier 2: Groq (failover LLM)
GROQ_API_KEY="your-groq-api-key"

# Tier 3: Alibaba Cloud DashScope (Qwen models)
DASHSCOPE_API_KEY="your-dashscope-api-key"

# Tier 4: OpenRouter (multi-model gateway)
OPENROUTER_API_KEY="your-openrouter-api-key"


# Push Notifications (VAPID keys for PWA)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Observability (optional)
SENTRY_DSN=""

# Feature Flags
ENABLE_VOICE_INPUT="true"
ENABLE_OFFLINE_MODE="true"

# ============================================================
# CARE CONNECT — Commercial Doctor Marketplace & Telemedicine
# (§2, §9, §26, §37, §62, §92, §95, §100)
# ============================================================

# Rollout stage: 1=internal team, 2=invited alpha, 3=pilot region, 4=soft launch, 5=public, 6=global
CARE_ROLLOUT_STAGE="1"

# Feature flags (defaults; overridden at runtime by FeatureFlag database table)
CARE_ENABLED="true"
CARE_PAYMENTS_ENABLED="false"
CARE_MESSAGING_ENABLED="true"
CARE_AUDIO_ENABLED="true"
CARE_VIDEO_ENABLED="true"
CARE_TRANSLATION_ENABLED="true"
CARE_PRESCRIPTIONS_ENABLED="false"
CARE_DOCTOR_PAYOUTS_ENABLED="false"
CARE_REVIEWS_ENABLED="true"
CARE_INSTANT_ENABLED="false"
CARE_FAVORITES_ENABLED="true"

# Care Connect Rollout Stage (§95): 1=Internal team, 2=Invited alpha, 3=Pilot region, 4=Soft launch, 5=PK corridor, 6=Global/Regional
CARE_ROLLOUT_STAGE="1"

# Payment provider selection: mock | pk-local | hesabpay | card
CARE_PAYMENT_PROVIDER="mock"

# Mock provider secrets (DEV/TEST ONLY — hard-blocked in production without CARE_ALLOW_MOCK_PAYMENTS=true)
CARE_MOCK_PAYMENT_SECRET="dev-mock-secret-replace-in-env"
CARE_ALLOW_MOCK_PAYMENTS="false"
CARE_CHECKOUT_SECRET="dev-checkout-secret-32-chars-long"

# Pakistan local gateway credentials (pk-local adapter)
CARE_PK_GATEWAY_KEY="your-pk-gateway-api-key"
CARE_PK_GATEWAY_SECRET="your-pk-gateway-secret"

# Afghanistan corridor (HesabPay adapter)
HESABPAY_API_KEY="your-hesabpay-api-key"
HESABPAY_MERCHANT_ID="your-hesabpay-merchant-id"

# International card gateway (card adapter)
CARE_CARD_GATEWAY_KEY="your-card-gateway-api-key"

# Earnings maturity delay before promotion from DOCTOR_PENDING to DOCTOR_AVAILABLE (hours)
CARE_EARNING_DELAY_HOURS="72"

# WebRTC Video & Audio Calling (§26, §27)
CARE_VIDEO_TOKEN_SECRET="generate-32-char-hmac-secret-for-tokens"
CARE_STUN_URL="stun:stun.l.google.com:19302"
CARE_VIDEO_SIGNAL_URL="ws://localhost:3004"
NEXT_PUBLIC_VIDEO_SIGNAL_URL=""

# Realtime messaging WebSocket / SSE gateway
CARE_REALTIME_WS_URL=""

# LiveKit adapter credentials (when livekit video provider is selected)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Private Object Storage (§37/§38) — AES-256-GCM encryption key
CARE_STORAGE_KEY="generate-strong-32-byte-hex-key-for-aes-256-gcm"

# S3 Storage adapter (production private buckets outside /public)
CARE_S3_BUCKET=""
CARE_S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
