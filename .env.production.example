# ==============================================================================
# SehatAI Care Connect — Production Environment Configuration Template
# ==============================================================================
# SAFE TO COMMIT: Contains placeholder values only. Copy to .env in production.
# NEVER commit real credentials, private keys, or passwords to source control.
# Every secret MUST be generated independently with cryptographic randomness.
# Store all production secrets in AWS Secrets Manager, Vault, or GCP Secret Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Base URLs
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
NEXTAUTH_URL="https://sehatai.health"
NEXT_PUBLIC_APP_URL="https://sehatai.health"
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_base64_32"

# ------------------------------------------------------------------------------
# 2. Managed PostgreSQL Production Cluster (§94)
# Multi-AZ RDS / Neon / Supabase Enterprise with automated continuous backup.
# SCRAM-SHA-256 authentication and enforced TLS (sslmode=require).
# POOLED connection for Next.js web processes; UNPOOLED connection for prisma migrate deploy.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://sehatai_prod_app:GENERATE_HIGH_ENTROPY_PASSWORD@prod-pooler.internal.sehatai.health:6543/sehatai_production?pgbouncer=true&sslmode=require"
DATABASE_URL_POOLED="postgresql://sehatai_prod_app:GENERATE_HIGH_ENTROPY_PASSWORD@prod-pooler.internal.sehatai.health:6543/sehatai_production?pgbouncer=true&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://sehatai_prod_migrator:GENERATE_HIGH_ENTROPY_PASSWORD@prod-primary.internal.sehatai.health:5432/sehatai_production?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Observability & Error Monitoring (Sentry / GlitchTip)
# Strict PHI scrubbing enabled: zero patient names, symptoms, or notes dispatched.
# ------------------------------------------------------------------------------
SENTRY_DSN="https://prod_public_key@sentry.sehatai.health/2"
SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 4. Durable Outbox Worker & Internal Cron Secret (§17)
# Required for scripts/run-outbox-worker.ts daemon and webhook verification.
# ------------------------------------------------------------------------------
INTERNAL_WORKER_KEY="GENERATE_WITH_openssl_rand_hex_32"
CRON_SECRET="GENERATE_WITH_openssl_rand_hex_32"

# ------------------------------------------------------------------------------
# 5. Production Web Push (VAPID) Credentials (§62)
# Production PWA service worker push notifications.
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY="GENERATE_WITH_web_push_generate_vapid_keys"
VAPID_PRIVATE_KEY="GENERATE_WITH_web_push_generate_vapid_keys"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="MATCHES_VAPID_PUBLIC_KEY"
VAPID_SUBJECT="mailto:security@sehatai.health"

# ------------------------------------------------------------------------------
# 6. Production AI Inference Providers (High-Quota Enterprise)
# Primary: Alibaba Cloud DashScope (Qwen 2.5 72B / Qwen-Plus / Qwen-Max)
# ------------------------------------------------------------------------------
DASHSCOPE_API_KEY="sk-prod-dashscope-enterprise-key"

# Tier 1 Fallback: Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY="prod-gemini-enterprise-key"

# Tier 2 Fallback: Groq Ultra-Low Latency
GROQ_API_KEY="gsk_prod_groq_enterprise_key"

# Multi-Model Fallback: OpenRouter
OPENROUTER_API_KEY="sk-or-v1-prod-openrouter-key"

# Production Google OAuth Client (for patient SSO)
GOOGLE_CLIENT_ID="prod-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="prod-client-secret"

# ------------------------------------------------------------------------------
# 7. Care Connect — Rollout Stage & Feature Flags (§95)
# Stage 3 = Pilot Region (Lahore/Karachi Family Medicine)
# Stage 4 = Soft Launch
# Stage 5 = Full Commercial Launch (Pakistan Domestic Corridor)
# Stage 6 = Regional Cross-Border Corridors (requires explicit regulatory approval)
# ------------------------------------------------------------------------------
CARE_ROLLOUT_STAGE="3"
CARE_ENABLED="true"
CARE_PAYMENTS_ENABLED="true"
CARE_MESSAGING_ENABLED="true"
CARE_AUDIO_ENABLED="true"
CARE_VIDEO_ENABLED="true"
CARE_TRANSLATION_ENABLED="true"
CARE_PRESCRIPTIONS_ENABLED="true"
CARE_DOCTOR_PAYOUTS_ENABLED="true"
CARE_REVIEWS_ENABLED="true"
CARE_INSTANT_ENABLED="false"
CARE_FAVORITES_ENABLED="true"

# Cross-border corridor protection (FAIL-CLOSED: disabled by default).
# NOTE: Setting this environment variable alone CANNOT activate cross-border care.
# Cross-border corridors strictly require a database-level JurisdictionPolicy with
# valid legalApprovalSource, humanApprovedById, active date window, scope (CROSS_BORDER/SECOND_OPINION),
# and per-doctor foreign jurisdiction licensing verified by human admin.
CARE_CROSS_BORDER_CORRIDOR_APPROVED="false"

# ------------------------------------------------------------------------------
# 8. Certified Commercial Payment Gateways (§9, §92)
# NEVER use 'mock' in production. Mock payments are hard-blocked at code level.
# Provider selection: pk-local | hesabpay | card
# ------------------------------------------------------------------------------
CARE_PAYMENT_PROVIDER="pk-local"
CARE_ALLOW_MOCK_PAYMENTS="false"
CARE_CHECKOUT_SECRET="GENERATE_WITH_openssl_rand_hex_32"

# Pakistan Merchant Gateway (1Link / PayFast / JazzCash / Bank Alfalah)
CARE_PK_GATEWAY_KEY="prod-live-pk-gateway-key"
CARE_PK_GATEWAY_SECRET="prod-live-pk-gateway-secret"

# Afghanistan Domestic Corridor (HesabPay - licensed Electronic Money Institution Zinzir Ltd)
HESABPAY_API_KEY="prod-live-hesabpay-api-key"
HESABPAY_MERCHANT_ID="prod-live-hesabpay-merchant-id"

# International Card Gateway (Stripe / 2Checkout / Checkout.com)
CARE_CARD_GATEWAY_KEY="prod-live-card-gateway-key"

# Earnings maturity delay before promotion from DOCTOR_PENDING to DOCTOR_AVAILABLE (hours)
# Standard: 72 hours escrow holding window for patient dispute resolution (§12)
CARE_EARNING_DELAY_HOURS="72"

# ------------------------------------------------------------------------------
# 9. Private Object Storage (§37/§38) — Multi-AZ Private Bucket
# Encrypted at rest: Client-side AES-256-GCM + AWS KMS SSE (aws:kms)
# ALL 4 S3 Block Public Access flags MUST be enabled on the bucket.
# ------------------------------------------------------------------------------
CARE_STORAGE_PROVIDER="s3"
CARE_STORAGE_KEY="GENERATE_32_BYTE_HEX_WITH_openssl_rand_hex_32"
CARE_S3_BUCKET="sehatai-prod-medical-vault-private"
CARE_S3_REGION="ap-south-1"
CARE_S3_KEY="PROD_IAM_USER_ACCESS_KEY_ID"
CARE_S3_SECRET="PROD_IAM_USER_SECRET_ACCESS_KEY"
CARE_S3_ENDPOINT=""

# ------------------------------------------------------------------------------
# 10. WebRTC Telemedicine & Clustered LiveKit SFU (§16, §26, §27)
# High-concurrency WebRTC SFU cluster with dedicated TURN relay servers.
# ------------------------------------------------------------------------------
CARE_VIDEO_PROVIDER="livekit"
CARE_VIDEO_TOKEN_SECRET="GENERATE_WITH_openssl_rand_hex_32"
LIVEKIT_URL="wss://livekit.sehatai.health"
LIVEKIT_API_KEY="prod-livekit-api-key"
LIVEKIT_API_SECRET="GENERATE_WITH_openssl_rand_hex_32"
CARE_STUN_URL="stun:stun.sehatai.health:3478"
NEXT_PUBLIC_VIDEO_SIGNAL_URL="wss://signal.sehatai.health"
