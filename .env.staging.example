# ==============================================================================
# SehatAI Care Connect — Staging Environment Configuration Template
# ==============================================================================
# SAFE TO COMMIT: Contains placeholder values only. Copy to .env in staging.
# NEVER commit real credentials or production secrets to source control.
# Generate high-entropy secrets using: openssl rand -hex 32 / openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Base URLs
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
NEXTAUTH_URL="https://staging.sehatai.health"
NEXT_PUBLIC_APP_URL="https://staging.sehatai.health"
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_base64_32"

# ------------------------------------------------------------------------------
# 2. Managed PostgreSQL Database (§94 Database Isolation)
# Connect to isolated staging database. NEVER point staging to production database.
# In serverless/container environments, use POOLED for web and UNPOOLED for migrations.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://sehatai_stg_app:REPLACE_WITH_STRONG_STAGING_PASSWORD@staging-db.sehatai.internal:5432/sehatai_staging?sslmode=require"
DATABASE_URL_POOLED="postgresql://sehatai_stg_app:REPLACE_WITH_STRONG_STAGING_PASSWORD@staging-pooler.sehatai.internal:6543/sehatai_staging?pgbouncer=true&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://sehatai_stg_app:REPLACE_WITH_STRONG_STAGING_PASSWORD@staging-db.sehatai.internal:5432/sehatai_staging?sslmode=require"
DIRECT_URL="postgresql://sehatai_stg_app:REPLACE_WITH_STRONG_STAGING_PASSWORD@staging-db.sehatai.internal:5432/sehatai_staging?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Observability & Error Monitoring (Sentry / GlitchTip)
# Protected Health Information (PHI) is automatically stripped before dispatch.
# ------------------------------------------------------------------------------
SENTRY_DSN="https://staging_public_key@sentry.sehatai.health/1"
SENTRY_ENVIRONMENT="staging"
NEXT_PUBLIC_SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 4. Durable Outbox Worker & Internal Cron (§17)
# ------------------------------------------------------------------------------
INTERNAL_WORKER_KEY="GENERATE_WITH_openssl_rand_hex_32"
CRON_SECRET="GENERATE_WITH_openssl_rand_hex_32"

# ------------------------------------------------------------------------------
# 5. Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY="REPLACE_WITH_STAGING_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="REPLACE_WITH_STAGING_VAPID_PRIVATE_KEY"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="REPLACE_WITH_STAGING_VAPID_PUBLIC_KEY"
VAPID_SUBJECT="mailto:devops-staging@sehatai.health"

# ------------------------------------------------------------------------------
# 6. AI Inference Providers (Cascade Hierarchy)
# Staging accounts with lower rate limits and billing quotas.
# ------------------------------------------------------------------------------
# Primary: Alibaba Cloud DashScope (Qwen 2.5 72B / Qwen-Plus)
DASHSCOPE_API_KEY="sk-staging-dashscope-key"

# Tier 1 Fallback: Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY="staging-gemini-key"

# Tier 2 Fallback: Groq Ultra-Low Latency
GROQ_API_KEY="gsk_staging_groq_key"

# Multi-Model Fallback: OpenRouter
OPENROUTER_API_KEY="sk-or-v1-staging-openrouter-key"

# Optional: Google OAuth Staging Client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 7. Care Connect — Rollout Stage & Feature Flags
# Stage 2 = Invited Alpha / Staff verification in staging environment
# ------------------------------------------------------------------------------
CARE_ROLLOUT_STAGE="2"
CARE_ENABLED="true"
CARE_PAYMENTS_ENABLED="true"
CARE_MESSAGING_ENABLED="true"
CARE_AUDIO_ENABLED="true"
CARE_VIDEO_ENABLED="true"
CARE_TRANSLATION_ENABLED="true"
CARE_PRESCRIPTIONS_ENABLED="true"
CARE_DOCTOR_PAYOUTS_ENABLED="true"
CARE_REVIEWS_ENABLED="true"
CARE_INSTANT_ENABLED="false"
CARE_FAVORITES_ENABLED="true"

# Cross-border corridor protection (FAIL-CLOSED: disabled by default).
# NOTE: Setting this environment variable alone CANNOT activate cross-border care.
# Cross-border corridors strictly require a database-level JurisdictionPolicy with
# valid legalApprovalSource, humanApprovedById, active date window, scope (CROSS_BORDER/SECOND_OPINION),
# and per-doctor foreign jurisdiction licensing verified by human admin.
CARE_CROSS_BORDER_CORRIDOR_APPROVED="false"

# ------------------------------------------------------------------------------
# 8. Payment Gateway Selection & Credentials
# Staging uses sandbox / mock provider. CARE_ALLOW_MOCK_PAYMENTS allows test cards.
# ------------------------------------------------------------------------------
CARE_PAYMENT_PROVIDER="mock"
CARE_ALLOW_MOCK_PAYMENTS="true"
CARE_MOCK_PAYMENT_SECRET="GENERATE_WITH_openssl_rand_hex_32"
CARE_CHECKOUT_SECRET="GENERATE_WITH_openssl_rand_hex_32"

# Staging Sandbox Gateways (when testing real sandbox webhooks)
CARE_PK_GATEWAY_KEY="sandbox-pk-key"
CARE_PK_GATEWAY_SECRET="sandbox-pk-secret"
HESABPAY_API_KEY="sandbox-hesabpay-key"
HESABPAY_MERCHANT_ID="sandbox-hesabpay-merchant"
CARE_CARD_GATEWAY_KEY="sandbox-card-key"

# Earnings maturity delay before promotion from DOCTOR_PENDING to DOCTOR_AVAILABLE (hours)
# Staging: 1 hour for rapid testing (Production: 72 hours)
CARE_EARNING_DELAY_HOURS="1"

# ------------------------------------------------------------------------------
# 9. Private Object Storage (§37/§38) — Staging S3 / OSS
# Enforces client-side AES-256-GCM encryption before upload + server-side KMS encryption.
# Never configure /public as storage root.
# ------------------------------------------------------------------------------
CARE_STORAGE_PROVIDER="s3"
CARE_STORAGE_KEY="GENERATE_WITH_openssl_rand_hex_32"
CARE_S3_BUCKET="sehatai-staging-medical-vault-private"
CARE_S3_REGION="ap-south-1"
CARE_S3_KEY="STAGING_AWS_ACCESS_KEY_ID"
CARE_S3_SECRET="STAGING_AWS_SECRET_ACCESS_KEY"
CARE_S3_ENDPOINT=""

# ------------------------------------------------------------------------------
# 10. WebRTC Telemedicine & LiveKit Cluster
# ------------------------------------------------------------------------------
CARE_VIDEO_PROVIDER="livekit"
CARE_VIDEO_TOKEN_SECRET="GENERATE_WITH_openssl_rand_hex_32"
CARE_STUN_URL="stun:stun.l.google.com:19302"
LIVEKIT_URL="wss://livekit-staging.sehatai.health"
LIVEKIT_API_KEY="staging_livekit_key"
LIVEKIT_API_SECRET="GENERATE_WITH_openssl_rand_hex_32"
NEXT_PUBLIC_VIDEO_SIGNAL_URL="wss://signal-staging.sehatai.health"
